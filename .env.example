# ============================================================
# CLIENT (VITE_*) — safe to ship in the browser bundle
# ============================================================

# URL of the deployed Cloud Functions AI proxy (see functions/README.md).
# The app calls this instead of Bedrock/Gemini directly, authenticated with the user's
# Firebase ID token. Without it, the app shows "AI service not configured".
VITE_AI_PROXY_URL=

# Which vision provider IntakeAgent uses in production code paths.
# Values: nova-2-lite | gemini-2.5-flash  (Gemini also requires GEMINI_API_KEY on the proxy)
VITE_VISION_PROVIDER=nova-2-lite
# Model name forwarded to the proxy when the Gemini provider is active.
VITE_GEMINI_MODEL=gemini-2.5-flash

# Firebase Auth / Firestore / Storage (client SDK config — not secret)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ============================================================
# SERVER-SIDE ONLY — NEVER expose these in the client / VITE_ vars
# ============================================================
# The real model keys live in Cloud Functions secrets:
#   firebase functions:secrets:set BEDROCK_API_KEY
#   firebase functions:secrets:set GEMINI_API_KEY   (optional)
#
# The offline intake eval scripts (scripts/eval, scripts/gen) also read these from the
# shell environment at run time — they are Node scripts, never bundled into the client:
#   BEDROCK_API_KEY=...  GEMINI_API_KEY=...  node scripts/eval/run-intake-eval.mjs
